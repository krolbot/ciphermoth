# Optional config for docker-compose.prod.yml. Copy to ".env" next to it and edit.
#   cp .env.prod.example .env
# Without a .env, CipherMoth runs on http://localhost:3000 with the latest release.

# Image version
# "latest", or pin to a release like 2.0.0 (no leading "v") for reproducible deploys.
CIPHERMOTH_VERSION=latest

# URL the BROWSER uses to reach the API (your host + backend port + /api):
CIPHERMOTH_API_URL=http://localhost:8000/api

# Origin the BROWSER loads the UI from (your host + frontend port):
CIPHERMOTH_FRONTEND_ORIGIN=http://localhost:3000

# Network exposure
# The UI and API are published on 127.0.0.1 only, so nothing else on your network
# can reach them. Keep that if a reverse proxy on this same host serves CipherMoth
# over HTTPS. To reach it directly from other machines (LAN, VPN, Tailscale),
# publish on every interface instead, and put HTTPS in front of it:
# CIPHERMOTH_BIND_ADDRESS=0.0.0.0

# Optional
# CIPHERMOTH_FRONTEND_PORT=3000
# CIPHERMOTH_BACKEND_PORT=8000

# Overrides every rate limit (unlock is 30/hour by default). Each CLI command
# unlocks once, so raise this if a batch of them trips it.
# CIPHERMOTH_RATE_LIMIT=200/hour

# Updates
# The app tells you when a release is out and shows the commands: take a
# snapshot of the vault, pull, restart. Snapshots and restores: docs/UPDATING.md.
